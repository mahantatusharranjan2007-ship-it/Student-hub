# App URL
APP_URL="MY_APP_URL"

# Supabase Public Configuration (safe for frontend Vite bundle)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Supabase Server Configuration (keep private, NEVER prefix with VITE_)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Initial Super Admin One-Time Provisioning Secret
# Used ONLY by the server-side provisioning script/endpoint for Student ID 5301K24032.
# Must be at least 12 characters. Never commit real values.
SUPER_ADMIN_INITIAL_PASSWORD="SET_STRONG_INITIAL_PASSWORD_IN_ENV"

# Optional extra header token required to invoke POST /api/setup/provision-super-admin
PROVISIONING_ADMIN_TOKEN="OPTIONAL_SETUP_TOKEN"
